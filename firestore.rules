rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for storefront visitors so anyone with the link sees live uploaded photos and catalog
    // Write permitted for store management
    match /store_collections/{collectionId} {
      allow read: if true;
      allow write: if true;
    }

    match /store_products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    match /store_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
